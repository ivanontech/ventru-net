{
  "name": "Ventru.net Stripe Payment Rail",
  "version": "0.1",
  "status": "demo_ready",
  "description": "Card, subscription, and invoice-friendly payment rail for humans and businesses using Ventru while x402 serves autonomous agent micropayments.",
  "requirements": {
    "paid_capsule": {
      "rail": "stripe",
      "mode": "demo_checkout_manifest",
      "currency": "usd",
      "amount_cents": 100,
      "amount_usd": 1,
      "product": "Ventru Action Capsule API Credit",
      "resource": "http://ventru.net/api/stripe/checkout-session",
      "purpose": "paid_action_capsule_generation",
      "checkout_session_endpoint": "http://ventru.net/api/stripe/checkout-session",
      "quote_endpoint": "http://ventru.net/api/stripe/quote",
      "success_url": "http://ventru.net/?stripe=success",
      "cancel_url": "http://ventru.net/?stripe=cancel",
      "payment_link": "https://buy.stripe.com/ventru-demo-action-capsule",
      "receipt_header": "X-STRIPE-SESSION",
      "settlement": "demo returns checkout_url; production verifies Stripe checkout.session.completed webhook before enabling paid resources"
    },
    "claimed_profile": {
      "rail": "stripe",
      "mode": "demo_checkout_manifest",
      "currency": "usd",
      "amount_cents": 4900,
