  "webhook": {
    "endpoint": "http://ventru.net/api/stripe/webhook",
    "verifies": [
      "checkout.session.completed",
      "invoice.paid",
      "payment_intent.succeeded"
    ]
  },
  "note": "MVP returns demo checkout URLs when STRIPE_SECRET_KEY is absent. Production should store the Stripe session id and verify webhooks before granting paid capabilities."
