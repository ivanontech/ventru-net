{
  "name": "Ventru.net",
  "version": "0.1",
  "description": "Machine-readable routing and trust layer for businesses that want AI agents to discover, compare, quote, book, and transact with them.",
  "homepage": "http://ventru.net/",
  "capabilities": {
    "search_businesses": true,
    "route_agent_intents": true,
    "generate_ventru_action_capsules": true,
